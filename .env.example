# Backend routing by environment:
# local       -> http://localhost:8000/
# dev/smoke   -> https://fitaly-backend-smoke.up.railway.app
# production  -> https://fitaly-backend-production.up.railway.app
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/
EXPO_PUBLIC_API_VERSION=v1
EXPO_PUBLIC_ENABLE_BACKEND_LOGGING=true

# Runtime flags
EXPO_PUBLIC_ENABLE_TELEMETRY=false
EXPO_PUBLIC_ENABLE_SMART_REMINDERS=true
# C2 launch-gated domains. Production and launch-like profiles keep these false
# until each feature wave has passed its release gate.
EXPO_PUBLIC_ENABLE_FOOD_LIBRARY=false
EXPO_PUBLIC_ENABLE_SMART_MEMORY=false
EXPO_PUBLIC_ENABLE_KNOWN_PATTERNS=false
EXPO_PUBLIC_ENABLE_RECIPE_CATALOG=false
EXPO_PUBLIC_ENABLE_PLANNING=false
EXPO_PUBLIC_ENABLE_HOME_NEXT_ACTION=false
EXPO_PUBLIC_ENABLE_REVIEW_MEMORY_EXPLANATION=false

# RevenueCat
RC_IOS_API_KEY=
RC_ANDROID_API_KEY=

# Legal links (required for production readiness checks)
TERMS_URL=https://lkurczab.netlify.app/fitaly/terms
PRIVACY_URL=https://lkurczab.netlify.app/fitaly/privacy

# Runtime toggles
DEBUG_OCR=false
DISABLE_BILLING=false

# Used only by scripts/download-fonts.mjs
GOOGLE_FONTS_KEY=

# Sentry
SENTRY_ORG=lukaszkurczab
SENTRY_PROJECT=fitaly-frontend
SENTRY_ENVIRONMENT=development
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
