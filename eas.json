{
  "cli": {
    "version": ">= 18.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "smoke": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://fitaly-backend-smoke.up.railway.app",
        "EXPO_PUBLIC_API_VERSION": "v1",
        "EXPO_PUBLIC_ENABLE_BACKEND_LOGGING": "true",
        "EXPO_PUBLIC_ENABLE_TELEMETRY": "true",
        "EXPO_PUBLIC_ENABLE_SMART_REMINDERS": "true",
        "EXPO_PUBLIC_ENABLE_FOOD_LIBRARY": "false",
        "EXPO_PUBLIC_ENABLE_SMART_MEMORY": "false",
        "EXPO_PUBLIC_ENABLE_KNOWN_PATTERNS": "false",
        "EXPO_PUBLIC_ENABLE_RECIPE_CATALOG": "false",
        "EXPO_PUBLIC_ENABLE_PLANNING": "false",
        "EXPO_PUBLIC_ENABLE_HOME_NEXT_ACTION": "false",
        "EXPO_PUBLIC_ENABLE_REVIEW_MEMORY_EXPLANATION": "false",
        "DISABLE_BILLING": "false",
        "SENTRY_ORG": "lukaszkurczab",
        "SENTRY_PROJECT": "fitaly",
        "SENTRY_ENVIRONMENT": "smoke"
      }
    },
    "development": {
      "extends": "smoke",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_TELEMETRY": "false"
      }
    },
    "preview": {
      "extends": "smoke",
      "developmentClient": true,
      "distribution": "internal"
    },
    "internal": {
      "extends": "smoke",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "e2e-test": {
      "extends": "smoke",
      "distribution": "internal",
      "withoutCredentials": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://fitaly-backend-smoke.up.railway.app",
        "EXPO_PUBLIC_API_VERSION": "v1",
        "EXPO_PUBLIC_ENABLE_BACKEND_LOGGING": "true",
        "E2E": "true",
        "E2E_MOCK_CHAT_REPLY": "E2E_MOCK_CHAT_REPLY: Keep hydration and protein consistent every day."
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://fitaly-backend-production.up.railway.app",
        "EXPO_PUBLIC_API_VERSION": "v1",
        "EXPO_PUBLIC_ENABLE_BACKEND_LOGGING": "false",
        "EXPO_PUBLIC_ENABLE_TELEMETRY": "true",
        "EXPO_PUBLIC_ENABLE_SMART_REMINDERS": "true",
        "EXPO_PUBLIC_ENABLE_FOOD_LIBRARY": "false",
        "EXPO_PUBLIC_ENABLE_SMART_MEMORY": "false",
        "EXPO_PUBLIC_ENABLE_KNOWN_PATTERNS": "false",
        "EXPO_PUBLIC_ENABLE_RECIPE_CATALOG": "false",
        "EXPO_PUBLIC_ENABLE_PLANNING": "false",
        "EXPO_PUBLIC_ENABLE_HOME_NEXT_ACTION": "false",
        "EXPO_PUBLIC_ENABLE_REVIEW_MEMORY_EXPLANATION": "false",
        "DISABLE_BILLING": "false",
        "DEBUG_OCR": "false",
        "SENTRY_ORG": "lukaszkurczab",
        "SENTRY_PROJECT": "fitaly",
        "SENTRY_ENVIRONMENT": "production"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
